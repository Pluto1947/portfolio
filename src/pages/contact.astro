---
import BaseLayout from '../layouts/BaseLayout.astro';
import Title from '../components/Title.astro';
import Dome from '../components/Dome.astro';
import services from '../../content/_services.json';

// Contact page (layout B): service cards on the left choose the topic, the form
// sits on the right. It is one Netlify form, so it works with JavaScript off:
// the cards are real radio buttons, and the plain submit goes to /contact/thanks.
// With JavaScript on, it submits in place and shows a thank you message.
// Services come from content/_services.json, so editing them needs no code change.

type Service = { title: string; description: string; badge?: string; icon?: string; accent?: string };
const list = services as Service[];

const ICONS: Record<string, string> = {
  shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z"/>',
  code: '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13 6l-2 12"/>',
  chat: '<path d="M4 5h16v11H8l-4 4V5z"/>',
  cloud: '<path d="M7 18h10a4 4 0 0 0 .5-8A6 6 0 0 0 6 9.5 4.3 4.3 0 0 0 7 18z"/>',
  brain: '<path d="M9 4a3 3 0 0 0-3 3 3 3 0 0 0-1 5.5A3 3 0 0 0 9 18v2m6-16a3 3 0 0 1 3 3 3 3 0 0 1 1 5.5A3 3 0 0 1 15 18v2M12 4v16"/>',
  star: '<path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7L12 3z"/>',
};
const icon = (name?: string) => ICONS[name ?? ''] ?? ICONS.star;
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<BaseLayout title="Contact · Dan">
  <div class="page">
    <a class="back" href="/">‹ Home</a>
    <header class="dhead">
      <Dome />
      <Title text="Contact" />
      <p class="lead">PLACEHOLDER: an intro line in your own words.</p>
    </header>

    <form
      class="contact"
      id="contact-form"
      name="contact"
      method="POST"
      action="/contact/thanks"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hp" aria-hidden="true">
        <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <fieldset class="cards">
        <legend class="sr-only">What's this about?</legend>
        {list.map((s) => (
          <label class="card" style={`--c: var(--${s.accent ?? 'teal'})`}>
            <input type="radio" name="topic" value={s.title} id={`topic-${slug(s.title)}`} />
            <span class="ico">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon(s.icon)} />
            </span>
            <span class="t">{s.title}{s.badge && <span class="tag">{s.badge}</span>}</span>
            <span class="d">{s.description}</span>
          </label>
        ))}
      </fieldset>

      <div class="panel-form">
        <p class="picked" id="picked" aria-live="polite">Pick a topic, or just write.</p>
        <div class="field">
          <label for="c-name">Name</label>
          <input id="c-name" name="name" autocomplete="name" placeholder="Your name" required />
        </div>
        <div class="field">
          <label for="c-email">Email</label>
          <input id="c-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
        </div>
        <div class="field">
          <label for="c-msg">Message</label>
          <textarea id="c-msg" name="message" placeholder="Tell me what you need" required></textarea>
        </div>
        <p class="err" id="send-error" role="alert" hidden>That didn't send. Please try again in a moment.</p>
        <button class="send" type="submit">Send message</button>
      </div>
    </form>

    <div class="done" id="sent" role="status" hidden>
      <b>Thanks, message sent.</b>
      <p>I will reply to your email soon.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .contact { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(22px, 4vw, 44px); margin-top: 30px; align-items: start; max-width: 1000px; }
  @media (max-width: 820px) { .contact { grid-template-columns: minmax(0, 1fr); } }

  .cards { display: flex; flex-direction: column; gap: 12px; border: 0; margin: 0; padding: 0; min-width: 0; }
  .card {
    position: relative; display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; align-items: start;
    border: 1px solid var(--line); border-radius: 14px; padding: 15px 16px; cursor: pointer;
    background: linear-gradient(180deg, rgba(27,32,67,0.9), rgba(22,26,53,0.88)); transition: border-color .2s, background .2s;
  }
  .card:hover { border-color: rgba(233,231,245,0.18); }
  .card input { position: absolute; opacity: 0; pointer-events: none; }
  .card:has(input:checked) { border-color: var(--c); background: color-mix(in srgb, var(--c) 9%, rgba(27,32,67,0.38)); }
  .card:has(input:focus-visible) { outline: 2px solid var(--c); outline-offset: 2px; }
  .ico { grid-row: span 2; width: 34px; height: 34px; border-radius: 9px; display: grid; place-items: center; background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); }
  .t { font-family: "Space Grotesk", sans-serif; font-weight: 500; font-size: 16px; color: var(--text); }
  .tag { font: 500 10.5px/1 "Inter", sans-serif; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c); border: 1px solid color-mix(in srgb, var(--c) 50%, transparent); border-radius: 999px; padding: 3px 7px; margin-left: 8px; vertical-align: 2px; }
  .d { color: var(--muted); font-size: 13.5px; line-height: 1.5; }

  .panel-form { display: flex; flex-direction: column; gap: 16px; border: 1px solid var(--line); border-radius: 16px; padding: clamp(16px, 3vw, 24px); background: rgba(15,18,38,0.94); min-width: 0; }
  .picked { font-size: 13px; color: var(--muted); margin: 0; }
  .picked :global(b) { color: var(--text); font-weight: 500; }
  .field { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
  .field label { font-family: "Space Grotesk", sans-serif; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .field input, .field textarea {
    width: 100%; font: inherit; font-size: 15px; color: var(--text); background: rgba(10,12,24,0.9);
    border: 1px solid rgba(233,231,245,0.18); border-radius: 10px; padding: 11px 13px; transition: border-color .2s, box-shadow .2s;
  }
  .field textarea { min-height: 140px; resize: vertical; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--teal); box-shadow: 0 0 0 3px rgba(45,212,191,0.15); }
  .send { align-self: flex-start; font: 600 14px/1 "Space Grotesk", sans-serif; letter-spacing: 0.04em; color: #0F1226; background: var(--teal); border: 0; border-radius: 10px; padding: 13px 22px; cursor: pointer; transition: box-shadow .2s, opacity .2s; }
  .send:hover { box-shadow: 0 0 18px rgba(45,212,191,0.45); }
  .send:disabled { opacity: 0.6; cursor: progress; }
  .send:focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; }
  .err { margin: 0; color: var(--coral); font-size: 13.5px; }
  .done { max-width: 560px; margin-top: 30px; border: 1px solid rgba(45,212,191,0.4); background: rgba(45,212,191,0.08); border-radius: 12px; padding: 16px 18px; }
  .done b { font-family: "Space Grotesk", sans-serif; font-weight: 500; }
  .done p { margin: 4px 0 0; color: var(--muted); font-size: 14px; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const picked = document.getElementById('picked');
  const sent = document.getElementById('sent');
  const err = document.getElementById('send-error');

  // Show the chosen topic above the fields; clicking a chosen card again clears it.
  form?.querySelectorAll<HTMLInputElement>('input[name="topic"]').forEach((r) => {
    let was = false;
    const card = r.closest('label');
    card?.addEventListener('pointerdown', () => (was = r.checked));
    card?.addEventListener('click', (e) => {
      if (was) { e.preventDefault(); r.checked = false; was = false; update(); }
    });
    r.addEventListener('change', update);
  });
  function update() {
    const r = form?.querySelector<HTMLInputElement>('input[name="topic"]:checked');
    if (!picked) return;
    picked.replaceChildren();
    if (r) { picked.append('Topic: '); const b = document.createElement('b'); b.textContent = r.value; picked.append(b); }
    else picked.textContent = 'Pick a topic, or just write.';
  }

  // Submit in place. Netlify accepts a urlencoded POST to "/" with form-name set.
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('.send');
    if (btn) btn.disabled = true;
    if (err) err.hidden = true;
    try {
      const body = new URLSearchParams(new FormData(form) as any).toString();
      const res = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
      if (!res.ok) throw new Error(String(res.status));
      form.hidden = true;
      if (sent) { sent.hidden = false; sent.setAttribute('tabindex', '-1'); sent.focus(); }
    } catch {
      if (err) err.hidden = false;
      if (btn) btn.disabled = false;
    }
  });
</script>
