---
import BaseLayout from '../layouts/BaseLayout.astro';
import Globe from '../components/Globe.astro';
import Photo from '../components/Photo.astro';
import site from '../../content/_site.json';
import { getDomains, itemsInDomain, accentFor, labelFor } from '../lib/graph';

// Home: the globe in the hero, with the domain colour key and the arc legend
// as one small row underneath. The intro (option C) shows the name large over
// a dimmed globe, then settles into the top corner after 2.5 s or on any
// interaction. It never takes clicks, so the globe stays fully usable. On phones
// it sits above the globe instead. Name and line come from content/_site.json.
const domains = await Promise.all(
  (await getDomains()).map(async (d) => ({ domain: d, count: (await itemsInDomain(d)).length })),
);
---

<BaseLayout title={`${site.name} · Portfolio`}>
  <section class="hero" id="hero">
    <div class="intro" id="intro" data-avoid>
      <Photo size={96} class="ip" eager />
      <div class="it">
        <h1 class="name">{site.name}</h1>
        <p class="line">{site.tagline}</p>
        <p class="hint"><span class="mouse">Drag the globe, click a pin, or press <kbd>`</kbd> (below Esc) for the terminal</span><span class="touch">Drag the globe, tap a pin, or open the terminal</span></p>
      </div>
    </div>
    <script is:inline>
      // Decide before first paint whether the intro plays, so the caption never
      // flashes in the corner first. It stays hidden until it has been centred.
      (function () {
        var seen = false;
        try { seen = sessionStorage.getItem('introSeen') === '1'; } catch (e) {}
        if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches || matchMedia('(max-width: 620px)').matches) return;
        document.getElementById('intro').classList.add('centred', 'pending', 'no-anim');
        document.getElementById('hero').classList.add('intro-on');
      })();
    </script>
    <Globe />

    <div class="key">
      <ul class="domkey" aria-label="Domains">
        {domains.map((d) => (
          <li>
            <a href={`/${d.domain}`} style={`--d:${accentFor(d.domain)}`}>
              {labelFor(d.domain)}<span class="n">{d.count > 0 ? d.count : 'soon'}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="arckey" aria-hidden="true">
        <span class="lg bio">journey</span>
        <span class="lg theme">connected work</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    min-height: 100vh; padding: 0 0 clamp(12px, 3vw, 32px);
  }
  .hero { position: relative; }

  /* intro: the caption always has its settled corner layout; during the intro a
     transform scales it up and moves it to the centre. Settling only animates
     transform and opacity, which the graphics card handles without re-layout. */
  .intro {
    position: absolute; z-index: 4; pointer-events: none;
    left: clamp(16px, 3vw, 40px); top: clamp(16px, 4vh, 40px); width: min(40%, 520px);
    display: flex; flex-direction: row; align-items: center; gap: 14px; text-align: left;
    transform-origin: 50% 50%;
    transition: transform .9s cubic-bezier(.2,.7,.2,1), opacity .45s ease;
  }
  .intro.pending { opacity: 0; }
  .intro.no-anim, .intro.no-anim * { transition: none !important; }
  .intro :global(.ip) { width: 64px; height: 64px; }
  .intro .it { min-width: 0; }
  .intro .name {
    margin: 0; font-family: "Space Grotesk", sans-serif; font-weight: 700; line-height: 1.04; text-wrap: balance;
    font-size: clamp(22px, 2.4vw, 32px); color: #dbfff7;
    text-shadow: 0 0 10px color-mix(in srgb, var(--teal) 55%, transparent), 1px 0 rgba(255,77,141,0.5), -1px 0 rgba(34,233,255,0.5);
  }
  .intro .line { margin: 6px 0 0; color: #d6d4ea; font-size: 14px; }
  .intro .hint { margin: 8px 0 0; color: var(--muted); font-size: 12.5px; transition: opacity .5s .45s; }
  .intro.centred .hint { opacity: 0; transition: none; }
  .intro .hint kbd { font: 11.5px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--text); border: 1px solid var(--line); border-radius: 4px; padding: 0 5px; }
  .intro .touch { display: none; }
  @media (hover: none) { .intro .mouse { display: none; } .intro .touch { display: inline; } }

  /* dimming: a flat overlay that fades, instead of a filter on the 3D canvas */
  .hero::after { content: ""; position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background: rgba(10, 12, 24, 0.62); opacity: 0; transition: opacity .9s ease; }
  .hero.intro-on::after { opacity: 1; }

  /* phones: no spare corner, so the intro sits above the globe in the page flow */
  @media (max-width: 620px) {
    .intro { position: static; transform: none !important; width: auto; padding: 20px 16px 0; align-self: stretch; gap: 12px; }
    .intro :global(.ip) { width: 56px; height: 56px; }
    .intro .name { font-size: 28px; }
    .intro .hint { opacity: 1 !important; }
    .hero::after { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .intro, .intro .hint, .hero::after { transition: none; } }

  .key { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .domkey { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 8px; }
  .domkey a {
    display: inline-flex; align-items: center; gap: 7px; text-decoration: none;
    font-size: 12.5px; color: var(--text); border: 1px solid var(--line); border-radius: 999px; padding: 4px 11px;
    transition: border-color .2s;
  }
  .domkey a::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--d); box-shadow: 0 0 8px 0 var(--d); }
  .domkey a:hover { border-color: color-mix(in srgb, var(--d) 60%, transparent); }
  .domkey .n { color: var(--muted); font-size: 11.5px; font-variant-numeric: tabular-nums; }

  .arckey { display: flex; gap: 16px; font-size: 11.5px; color: var(--muted); }
  .lg::before { content: ""; display: inline-block; width: 18px; border-top: 2px solid; margin-right: 7px; vertical-align: middle; }
  .lg.bio::before { border-top-style: dashed; border-color: var(--coral); }
  .lg.theme::before { border-color: var(--violet); }

  @media (max-width: 620px) { .hero { min-height: auto; } }

  .key { padding-inline: 16px; }
</style>

<script>
  const hero = document.getElementById('hero');
  const intro = document.getElementById('intro');
  if (hero && intro && intro.classList.contains('centred')) {
    const events = ['pointerdown', 'wheel', 'keydown', 'touchstart'] as const;

    // Move the settled caption to the centre of the hero and scale it up.
    const centre = () => {
      const prev = intro.style.transform;
      intro.style.transform = 'none';
      const h = hero.getBoundingClientRect(), r = intro.getBoundingClientRect();
      const scale = Math.min(2, (h.width * 0.86) / r.width);
      const dx = h.left + h.width / 2 - (r.left + r.width / 2);
      const dy = h.top + h.height / 2 - 40 - (r.top + r.height / 2);
      intro.style.transform = prev && prev !== 'none' ? prev : '';
      intro.style.transform = `translate(${dx}px, ${dy}px) scale(${scale})`;
    };
    const onResize = () => {
      if (!intro.classList.contains('centred')) return;
      intro.classList.add('no-anim'); centre(); requestAnimationFrame(() => intro.classList.remove('no-anim'));
    };
    const settle = () => {
      if (!intro.classList.contains('centred')) return;
      intro.classList.remove('centred', 'pending'); intro.style.transform = ''; hero.classList.remove('intro-on');
      try { sessionStorage.setItem('introSeen', '1'); } catch {}
      for (const ev of events) window.removeEventListener(ev, settle);
      window.removeEventListener('resize', onResize);
    };
    centre();
    // two frames later: turn transitions back on and fade the centred caption in
    requestAnimationFrame(() => requestAnimationFrame(() => { intro.classList.remove('no-anim', 'pending'); }));
    for (const ev of events) window.addEventListener(ev, settle, { passive: true });
    window.addEventListener('resize', onResize);
    setTimeout(settle, 2500);
  }
</script>
