---
// Site background (Phase 6, version D): three layers of stars at different
// depths that drift and shift with the pointer, plus a shooting star every
// 1 to 3 minutes. One fixed canvas behind all content, no library.
// Reduced motion: stars are drawn once and nothing moves.
---

<canvas class="starfield" id="starfield" aria-hidden="true"></canvas>

<style>
  .starfield { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; display: block; }
  :global(.stage) { position: relative; z-index: 1; }
</style>

<script>
  const cv = document.getElementById('starfield') as HTMLCanvasElement | null;
  const ctx = cv?.getContext('2d');
  if (cv && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // mostly white, some cool blue, a few warm
    const TINTS = ['233,231,245', '233,231,245', '233,231,245', '190,210,255', '170,200,255', '255,226,190'];
    // [area per star, radius, alpha, drift px/s, parallax px, glow]
    const LAYERS: [number, number, number, number, number, boolean][] = [
      [2200, 0.45, 0.32, 1.2, 4, false],
      [6500, 0.85, 0.5, 3, 10, false],
      [26000, 1.45, 0.78, 6, 20, true],
    ];
    type Star = { x: number; y: number; r: number; a: number; c: string; tw: boolean; ph: number };
    type Shot = { x: number; y: number; dx: number; dy: number; t0: number; dur: number; len: number };
    let W = 0, H = 0;
    let layers: { drift: number; par: number; glow: boolean; stars: Star[] }[] = [];
    const shots: Shot[] = [];
    let mx = 0, my = 0, tx = 0, ty = 0;

    function size() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = window.innerWidth; H = window.innerHeight;
      cv!.width = Math.round(W * dpr); cv!.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      const r = Math.random;
      layers = LAYERS.map(([area, rad, al, drift, par, glow]) => ({
        drift, par, glow,
        stars: Array.from({ length: Math.round((W * H) / area) }, () => ({
          x: r() * W, y: r() * H, r: rad * (0.7 + r() * 0.6), a: al * (0.6 + r() * 0.4),
          c: TINTS[Math.floor(r() * TINTS.length)], tw: r() < 0.3, ph: r() * 6.28,
        })),
      }));
    }

    function fireShot() {
      const r = Math.random, ang = ((20 + r() * 25) * Math.PI) / 180;
      shots.push({ x: 0.15 + r() * 0.6, y: 0.05 + r() * 0.3, dx: Math.cos(ang), dy: Math.sin(ang), t0: performance.now(), dur: 900 + r() * 400, len: 0.12 + r() * 0.06 });
      if (shots.length > 4) shots.shift();
    }

    function draw(t: number) {
      ctx!.clearRect(0, 0, W, H);
      mx += (tx - mx) * 0.05; my += (ty - my) * 0.05;
      const secs = reduce ? 0 : t / 1000;
      for (const L of layers) {
        const ox = -mx * L.par, oy = -my * L.par;
        for (const s of L.stars) {
          const x = (((s.x - secs * L.drift + ox) % W) + W) % W, y = s.y + oy;
          let a = s.a;
          if (s.tw && !reduce) a *= 0.6 + 0.4 * Math.sin(t / 1100 + s.ph);
          if (L.glow) {
            const g = ctx!.createRadialGradient(x, y, 0, x, y, s.r * 5);
            g.addColorStop(0, `rgba(${s.c},${a * 0.35})`); g.addColorStop(1, `rgba(${s.c},0)`);
            ctx!.fillStyle = g; ctx!.beginPath(); ctx!.arc(x, y, s.r * 5, 0, 7); ctx!.fill();
          }
          ctx!.fillStyle = `rgba(${s.c},${a})`; ctx!.beginPath(); ctx!.arc(x, y, s.r, 0, 7); ctx!.fill();
        }
      }
      for (const sh of shots) {
        const p = (t - sh.t0) / sh.dur;
        if (p < 0 || p > 1) continue;
        const span = Math.max(W, H);
        const hx = sh.x * W + sh.dx * sh.len * 2.2 * p * span, hy = sh.y * H + sh.dy * sh.len * 2.2 * p * span;
        const tl = sh.len * span * Math.min(1, p * 3) * (1 - Math.max(0, p - 0.7) / 0.3);
        const ex = hx - sh.dx * tl, ey = hy - sh.dy * tl;
        const fade = p < 0.8 ? 1 : 1 - (p - 0.8) / 0.2;
        const g = ctx!.createLinearGradient(hx, hy, ex, ey);
        g.addColorStop(0, `rgba(255,255,255,${0.95 * fade})`); g.addColorStop(0.3, `rgba(190,230,255,${0.45 * fade})`); g.addColorStop(1, 'rgba(190,230,255,0)');
        ctx!.strokeStyle = g; ctx!.lineWidth = 1.6; ctx!.lineCap = 'round';
        ctx!.beginPath(); ctx!.moveTo(hx, hy); ctx!.lineTo(ex, ey); ctx!.stroke();
        ctx!.fillStyle = `rgba(255,255,255,${fade})`; ctx!.beginPath(); ctx!.arc(hx, hy, 1.6, 0, 7); ctx!.fill();
      }
    }

    size();
    window.addEventListener('resize', () => { size(); if (reduce) draw(0); });
    if (reduce) {
      draw(0);
    } else {
      window.addEventListener('pointermove', (e) => { tx = e.clientX / W - 0.5; ty = e.clientY / H - 0.5; }, { passive: true });
      // about 30 frames a second is plenty for slow drift and saves battery
      let last = 0;
      const loop = (t: number) => { if (t - last > 32) { draw(t); last = t; } requestAnimationFrame(loop); };
      requestAnimationFrame(loop);
      const schedule = () => setTimeout(() => { if (!document.hidden) fireShot(); schedule(); }, 60000 + Math.random() * 120000);
      schedule();
    }
  }
</script>
