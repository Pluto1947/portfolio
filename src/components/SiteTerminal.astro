---
// Site terminal (Phase 5, placement C): a corner button, or the backtick key,
// opens a scripted terminal over any page. Commands are built from content at
// build time, so new write-ups and domains appear with no code change.
// whoami text and extra fixed commands come from content/_terminal.json.
import fs from 'node:fs';
import path from 'node:path';
import terminal from '../../content/_terminal.json';
import { getDomains, getItems } from '../lib/graph';

const items = await getItems();
const domains = await getDomains();
const castFor = (domain: string, slug: string) => {
  try {
    const f = fs.readdirSync(path.resolve('content', domain, slug)).find((n) => n.endsWith('.cast'));
    return f ? `/${domain}/${slug}/${f}` : null;
  } catch { return null; }
};
const data = {
  whoami: terminal.whoami,
  extra: (terminal as { commands?: Record<string, string> }).commands ?? {},
  domains: domains.map((d) => ({
    slug: d,
    items: items.filter((i) => i.domains.includes(d)).map((i) => ({
      slug: i.slug, title: i.data.title, type: i.data.type, url: i.url, cast: castFor(i.domain, i.slug),
    })),
  })),
};
---

<button class="st-fab" id="st-fab" type="button" aria-controls="st-pop" aria-expanded="false">
  <b aria-hidden="true">&gt;_</b> Terminal <kbd aria-hidden="true">`</kbd>
</button>

<div class="st-pop" id="st-pop" role="dialog" aria-label="Site terminal" hidden>
  <div class="st-bar">
    <i></i><i></i><i></i><span id="st-title">dan@portfolio: ~</span>
    <button class="st-x" type="button" aria-label="Close terminal">×</button>
  </div>
  <div class="st-player" id="st-player" hidden></div>
  <div class="st-scr" id="st-scr" aria-live="polite"></div>
  <div class="st-chips" id="st-chips"></div>
</div>

<script type="application/json" id="st-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />

<style>
  .st-fab {
    position: fixed; z-index: 80;
    right: calc(18px + env(safe-area-inset-right, 0px)); bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    display: inline-flex; align-items: center; gap: 8px;
    font: 500 13px/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--text);
    background: rgba(15,18,38,0.92); border: 1px solid rgba(233,231,245,0.18); border-radius: 999px;
    padding: 10px 14px; cursor: pointer; transition: border-color .2s, box-shadow .2s;
  }
  .st-fab:hover, .st-fab:focus-visible { border-color: var(--teal); box-shadow: 0 0 16px rgba(45,212,191,0.3); outline: none; }
  .st-fab b { color: var(--teal); font-weight: 500; }
  .st-fab kbd { font: inherit; font-size: 11px; color: var(--muted); border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; }
  @media (hover: none) { .st-fab kbd { display: none; } }

  .st-pop {
    position: fixed; z-index: 81;
    right: calc(18px + env(safe-area-inset-right, 0px)); bottom: calc(70px + env(safe-area-inset-bottom, 0px));
    width: min(560px, calc(100vw - 36px)); display: flex; flex-direction: column; max-height: min(70vh, 560px);
    border: 1px solid rgba(233,231,245,0.18); border-radius: 12px; overflow: hidden; background: #090b17;
    box-shadow: 0 24px 60px -20px rgba(0,0,0,0.85);
    font: 13.5px/1.55 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  @media (max-width: 620px) {
    .st-pop { left: 12px; right: 12px; width: auto; bottom: calc(66px + env(safe-area-inset-bottom, 0px)); max-height: 65vh; }
    .st-fab { right: calc(12px + env(safe-area-inset-right, 0px)); bottom: calc(12px + env(safe-area-inset-bottom, 0px)); }
  }
  .st-bar { display: flex; align-items: center; gap: 7px; padding: 9px 12px; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 11.5px; flex: none; }
  .st-bar i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; background: rgba(233,231,245,0.18); }
  .st-bar span { margin-left: 8px; }
  .st-x { margin-left: auto; background: none; border: 0; color: var(--muted); font: inherit; font-size: 18px; line-height: 1; cursor: pointer; padding: 0 4px; }
  .st-x:hover { color: var(--text); }
  .st-player { flex: none; border-bottom: 1px solid var(--line); }
  .st-scr { flex: 1; min-height: 160px; overflow-y: auto; padding: 12px 14px; white-space: pre-wrap; word-break: break-word; color: #d7f5ef; cursor: text; }
  .st-scr :global(.p) { color: var(--teal); }
  .st-scr :global(.a) { color: var(--violet); }
  .st-scr :global(.d) { color: var(--muted); }
  .st-scr :global(.w) { color: var(--coral); }
  .st-scr :global(a) { color: var(--teal); text-underline-offset: 3px; }
  .st-scr :global(.ln) { display: flex; gap: 8px; }
  .st-scr :global(.ln input) { flex: 1; min-width: 0; font: inherit; color: var(--text); background: transparent; border: 0; outline: none; caret-color: var(--teal); padding: 0; }
  .st-chips { flex: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 12px 10px; border-top: 1px solid var(--line); }
  .st-chips :global(button) { font: inherit; font-size: 12px; color: #cfcde6; background: none; border: 1px solid var(--line); border-radius: 6px; padding: 3px 8px; cursor: pointer; }
  .st-chips :global(button:hover), .st-chips :global(button:focus-visible) { border-color: var(--teal); color: var(--text); outline: none; }
</style>

<script>
  type It = { slug: string; title: string; type: string; url: string; cast: string | null };
  type Data = { whoami: string; extra: Record<string, string>; domains: { slug: string; items: It[] }[] };

  const raw = document.getElementById('st-data')?.textContent;
  const fab = document.getElementById('st-fab') as HTMLButtonElement | null;
  const pop = document.getElementById('st-pop') as HTMLElement | null;
  const scr = document.getElementById('st-scr') as HTMLElement | null;
  const chips = document.getElementById('st-chips') as HTMLElement | null;
  const playerBox = document.getElementById('st-player') as HTMLElement | null;

  if (raw && fab && pop && scr && chips && playerBox) {
    const data = JSON.parse(raw) as Data;
    const all = data.domains.flatMap((d) => d.items.map((i) => ({ ...i, domain: d.slug })));
    const unique = [...new Map(all.map((i) => [i.slug, i])).values()];
    const find = (s: string) => unique.find((i) => i.slug === s);
    const findDomain = (s: string) => data.domains.find((d) => d.slug === s.replace(/\/$/, ''));
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

    let cwd = '~';
    const hist: string[] = [];
    let hi = 0;
    let input: HTMLInputElement;
    let player: { dispose?: () => void } | null = null;

    const out = (html: string) => { const d = document.createElement('div'); d.innerHTML = html; scr.append(d); };
    const prompt = () => `<span class="p">dan@portfolio</span>:<span class="a">${esc(cwd)}</span>$ `;
    const go = (url: string) => { out(`<span class="d">opening ${esc(url)}…</span>`); window.location.href = url; };

    const title = document.getElementById('st-title');
    function newLine() {
      if (title) title.textContent = `dan@portfolio: ${cwd}`;
      const l = document.createElement('div'); l.className = 'ln';
      l.innerHTML = `<span>${prompt()}</span>`;
      input = document.createElement('input');
      input.setAttribute('aria-label', 'Terminal command');
      input.autocomplete = 'off'; input.spellcheck = false; input.autocapitalize = 'off';
      l.append(input); scr.append(l);
      input.addEventListener('keydown', onKey);
      scr.scrollTop = scr.scrollHeight;
    }

    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') { e.stopPropagation(); close(); return; }
      if (e.key === 'Enter') { run(input.value); return; }
      if (e.key === 'ArrowUp') { e.preventDefault(); if (hi > 0) input.value = hist[--hi] ?? ''; return; }
      if (e.key === 'ArrowDown') { e.preventDefault(); hi = Math.min(hi + 1, hist.length); input.value = hist[hi] ?? ''; return; }
      if (e.key === 'Tab') {
        e.preventDefault();
        const hasArg = /\s/.test(input.value.trimStart());
        const [c = '', a = ''] = input.value.trimStart().split(/\s+/);
        const pool = !hasArg ? ['help', 'whoami', 'ls', 'cd', 'open', 'play', 'contact', 'home', 'clear', ...Object.keys(data.extra)]
          : c === 'cd' ? data.domains.map((d) => d.slug)
          : c === 'play' ? unique.filter((i) => i.cast).map((i) => i.slug)
          : c === 'open' ? [...data.domains.map((d) => d.slug), ...unique.map((i) => i.slug)]
          : [];
        const word = hasArg ? a : c;
        const m = pool.filter((s) => s.startsWith(word));
        if (m.length === 1) input.value = hasArg ? `${c} ${m[0]}` : `${m[0]} `;
        else if (m.length > 1) {
          // list the matches above the current input line
          const d = document.createElement('div');
          d.innerHTML = `<span class="d">${m.map(esc).join('  ')}</span>`;
          scr.insertBefore(d, input.closest('.ln'));
        }
      }
    }

    async function play(item: It) {
      if (!item.cast) { out(`<span class="d">${esc(item.slug)} has no recording</span>`); return; }
      out(`▶ playing <span class="a">${esc(item.slug)}</span> <span class="d">(space pauses, close with ×)</span>`);
      try {
        const [Ap] = await Promise.all([import('asciinema-player'), import('asciinema-player/dist/bundle/asciinema-player.css')]);
        player?.dispose?.();
        playerBox.replaceChildren();
        const host = document.createElement('div');
        const x = document.createElement('button');
        x.type = 'button'; x.className = 'st-x'; x.textContent = '×'; x.setAttribute('aria-label', 'Close recording');
        x.style.cssText = 'display:block;margin:4px 8px 0 auto';
        x.addEventListener('click', () => { player?.dispose?.(); player = null; playerBox.hidden = true; input.focus(); });
        playerBox.append(x, host);
        playerBox.hidden = false;
        player = Ap.create(item.cast, host, { autoPlay: true, theme: 'aurora', fit: 'width', idleTimeLimit: 2,
          terminalFontFamily: 'ui-monospace, SFMono-Regular, Menlo, Consolas, monospace' });
      } catch {
        out('<span class="w">the player could not load, try again</span>');
      }
    }

    function run(rawCmd: string) {
      const cmd = rawCmd.trim();
      input.replaceWith(document.createTextNode(cmd));
      if (cmd) { hist.push(cmd); hi = hist.length; }
      const [c = '', ...rest] = cmd.split(/\s+/);
      const a = rest.join(' ');
      switch (c) {
        case '': break;
        case 'help':
          out([
            '<span class="d">commands</span>',
            '  whoami            who is Dan',
            '  ls                list domains, or items in the current one',
            '  cd &lt;domain&gt;       move into a domain (cd .. to go back)',
            '  open &lt;name&gt;       go to a domain or a page',
            '  play &lt;name&gt;       play its terminal recording',
            '  contact           go to the contact page',
            '  home              go to the globe',
            '  clear             clear the screen',
            ...Object.keys(data.extra).map((k) => `  ${esc(k)}`),
            '<span class="d">tab completes, arrow up recalls history, ` toggles this terminal</span>',
          ].join('\n'));
          break;
        case 'whoami': out(esc(data.whoami)); break;
        case 'ls': {
          if (cwd === '~') out(data.domains.map((d) => `<span class="a">${esc(d.slug)}/</span>  <span class="d">${d.items.length || 'coming soon'}</span>`).join('\n'));
          else {
            const d = findDomain(cwd.slice(2));
            out(d && d.items.length ? d.items.map((i) => `${esc(i.slug)}  <span class="d">${esc(i.type)}${i.cast ? ' · rec' : ''}</span>`).join('\n') : '<span class="d">nothing here yet</span>');
          }
          break;
        }
        case 'cd':
          if (!a || a === '~' || a === '..' || a === '/') cwd = '~';
          else if (findDomain(a)) cwd = '~/' + a.replace(/\/$/, '');
          else out(`<span class="w">cd: no such domain: ${esc(a)}</span>`);
          break;
        case 'open': {
          const target = a || (cwd !== '~' ? cwd.slice(2) : '');
          const d = findDomain(target), i = find(target);
          if (i) go(i.url); else if (d) go(`/${d.slug}`);
          else out(`<span class="w">open: not found: ${esc(target)}</span>  <span class="d">try ls</span>`);
          break;
        }
        case 'play': {
          const i = find(a);
          if (i) { play(i); } else out(`<span class="w">play: not found: ${esc(a)}</span>  <span class="d">try ls</span>`);
          break;
        }
        case 'contact': go('/contact'); break;
        case 'home': go('/'); break;
        case 'clear': scr.innerHTML = ''; break;
        default:
          if (Object.prototype.hasOwnProperty.call(data.extra, c)) out(esc(data.extra[c]));
          else out(`<span class="w">command not found: ${esc(c)}</span>  <span class="d">type help</span>`);
      }
      newLine();
      input.focus({ preventScroll: true });
    }

    // tap targets for phones
    const firstRec = unique.find((i) => i.cast);
    const firstItem = unique[0];
    const quick = ['help', 'whoami', 'ls', ...(data.domains[0] ? [`cd ${data.domains.find((d) => d.items.length)?.slug ?? data.domains[0].slug}`] : []),
      ...(firstItem ? [`open ${firstItem.slug}`] : []), ...(firstRec ? [`play ${firstRec.slug}`] : []), 'clear'];
    for (const q of quick) {
      const b = document.createElement('button');
      b.type = 'button'; b.textContent = q;
      b.addEventListener('click', () => { input.value = q; run(q); });
      chips.append(b);
    }

    scr.innerHTML = '<div class="d">Welcome. Type <span class="p">help</span> to see what you can do.</div>';
    newLine();
    scr.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('a')) input.focus({ preventScroll: true }); });

    function open() { pop.hidden = false; fab.setAttribute('aria-expanded', 'true'); input.focus({ preventScroll: true }); }
    function close() { pop.hidden = true; fab.setAttribute('aria-expanded', 'false'); player?.dispose?.(); player = null; playerBox.hidden = true; fab.focus({ preventScroll: true }); }
    fab.addEventListener('click', () => (pop.hidden ? open() : close()));
    pop.querySelector('.st-bar .st-x')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
      if (e.key === '`' && !e.metaKey && !e.ctrlKey && !e.altKey && (!typing || pop.contains(t))) { e.preventDefault(); pop.hidden ? open() : close(); }
    });
  }
</script>
