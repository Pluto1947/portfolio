---
// Dan's photo in the confirmed frame (style A): a circle with a thin teal ring
// and a faint halo, like the map pins. Renders nothing when no photo is set.
import { Image } from 'astro:assets';
import site from '../../content/_site.json';
import { getPhoto } from '../lib/photo';

interface Props { size: number; class?: string; eager?: boolean }
const { size, class: cls = '', eager = false } = Astro.props;
const photo = getPhoto();
---

{photo && (
  <span class={`photo ${cls}`} style={`--s:${size}px`}>
    <Image src={photo} alt={`Photo of ${site.name}`} width={size * 2} height={size * 2} fit="cover" format="webp" quality={80}
      loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </span>
)}

<style>
  .photo { display: block; flex: none; width: var(--s); height: var(--s); border-radius: 50%; overflow: hidden;
    box-shadow: 0 0 0 2px rgba(45, 212, 191, 0.75), 0 0 0 6px rgba(45, 212, 191, 0.12); background: #1b2043; }
  .photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
